; High-pressure "squeeze" phase for bulk liquid/melt boxes (step0/step1).
; See config.yaml's bulk.squeeze_pressure_bar/squeeze_ps comment for why
; this phase exists and what it does to the box before bulk_npt takes over.
define                  = -DLOPLS
integrator              = md
dt                      = 0.002
nsteps                  = {squeeze_nsteps}
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds

cutoff-scheme  = Verlet
coulombtype    = PME
rvdw           = 1.1
rcoulomb       = 1.1
rlist          = 1.1
pbc            = xyz

tcoupl      = v-rescale
tc-grps     = System
tau_t       = 1.0
ref_t       = {temperature_K}

pcoupl          = c-rescale
pcoupltype      = isotropic
tau_p           = 1.0
ref_p           = {squeeze_pressure_bar}
compressibility = 4.5e-5

gen_vel     = no

nstxout     = 0
nstenergy   = 500
nstlog      = 2000
