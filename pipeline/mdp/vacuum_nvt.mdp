; NVT for the single-molecule vacuum CED reference (step1) -- same
; nonbonded method/cutoffs as mdp/nvt.mdp (the liquid-phase NVT), see
; vacuum_nvt rule's docstring for why that consistency matters. Adds a
; one-sided (flat-bottom) pull restraint between the oligomer's two
; terminal cap atoms (index groups ChainEnd1/ChainEnd2, written by the
; vacuum_nvt rule itself), active only when the end-to-end distance drops
; below pull_target_nm -- confirmed live 2026-11-16 that an unrestrained
; floppy 10-mer collapses in vacuum and self-solvates its own polar
; groups: MMA10's intramolecular Coulomb(SR) (-1304 kJ/mol) came out
; nearly equal to the liquid phase's intermolecular Coulomb(SR) per
; molecule (-1319 kJ/mol), collapsing the vacuum/liquid energy gap the
; whole CED method depends on and driving chi_BS to ~0.
define                  = -DLOPLS
integrator              = md
dt                      = 0.002
nsteps                  = {nvt_nsteps}
continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds

cutoff-scheme  = Verlet
coulombtype    = PME
rvdw           = 1.1
rcoulomb       = 1.1
rlist          = 1.1
pbc            = xyz

tcoupl      = v-rescale
tc-grps     = System
tau_t       = 1.0
ref_t       = {temperature_K}

gen_vel     = yes
gen_temp    = {temperature_K}
gen_seed    = -1

nstxout     = 0
nstvout     = 0
nstenergy   = 500
nstlog      = 500

pull                 = yes
pull-ncoords         = 1
pull-ngroups         = 2
pull-group1-name     = ChainEnd1
pull-group2-name     = ChainEnd2
pull-coord1-type     = flat-bottom-high
pull-coord1-geometry = distance
pull-coord1-groups   = 1 2
pull-coord1-dim      = Y Y Y
pull-coord1-start    = no
pull-coord1-init     = {pull_target_nm}
pull-coord1-rate     = 0
pull-coord1-k        = {pull_k}
pull-nstxout         = 0
pull-nstfout         = 0
