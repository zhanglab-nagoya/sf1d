# Shared preamble, included by every stage template in this
# directory via Jinja's `include` directive (scripts/render_template.py's
# Jinja Environment uses a
# FileSystemLoader rooted at this directory, so includes resolve between
# sibling template files with no extra plumbing). Added 2026-11-08 when
# step 2 chis stages 4-5 moved from one continuous LAMMPS session into
# separate Snakemake rules -- see rules/step2_equilibrate.smk's module
# docstring for why that split is now safe (merged_coeffs.lmp carries
# bond/angle/dihedral_coeff commands explicitly, so write_data no longer
# needs to preserve `bond_style hybrid harmonic`'s Coeffs sections across
# stages).
#
# `params.read_data` is the one thing that varies per stage (each stage
# reads the previous stage's write_data output, except the first, which
# reads merged.data itself); every other setting here is identical for
# every stage.
units real
atom_style full
boundary p p p

bond_style hybrid harmonic
angle_style hybrid harmonic
dihedral_style hybrid multi/harmonic
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
pair_style lj/cut/coul/long {{ params.cutoff }}
kspace_style pppm {{ params.kspace_accuracy }}

# pair_style must be declared before read_data -- confirmed live
# 2026-11-08: unlike merge_slab.py's merged.data (which deliberately has
# no "Pair Coeffs" section at all, see its own module docstring), a
# write_data checkpoint from any LAMMPS stage below DOES embed one for
# this plain (non-hybrid) pair_style, and read_data errors ("Must define
# pair_style before Pair Coeffs") if pair_style isn't already known. The
# embedded values get overwritten by merged_coeffs.lmp's pair_coeff
# commands below regardless, so this doesn't depend on what read_data
# happened to load from that section.
read_data {{ params.read_data }}

include merged_coeffs.lmp
pair_modify mix geometric

group mobile type 1:{{ params.n_org_types }}
group substrate type {{ params.n_org_types + 1 }}:{{ params.n_org_types + 2 }}
velocity substrate set 0.0 0.0 0.0

{% if params.frag_molid_lo is defined %}
# Stage 5's density profiles need the single adsorbing fragment split out
# from the many hexadecane molecules within `mobile`. Only defined once a
# fragment has actually been inserted (scripts/insert_fragment.py,
# rules/step2_equilibrate.smk) -- the solvent-only equilibration stages
# have no fragment at all, so `mobile` alone stands in for "hexadecane"
# there (see the "Decouple fragment insertion from solvent/substrate
# equilibration" plan). insert_fragment.py places hexadecane's own
# molecule-IDs unchanged at [1..max_org_molid] and appends the fragment's
# 3 residues (cap/core/cap -- a fragment_length=1 "CH3n-{species}-CH3n"
# capped repeat unit is written by GROMACS/polyply as THREE separate
# molecule-IDs, see rules/step2_dilute.smk's build_fragment_itp
# docstring) numerically after the substrate's own single molid, at
# [frag_molid_lo..frag_molid_hi] -- both ranges passed in as params below,
# not hardcoded, since their absolute values depend on how many
# hexadecane molecules insert_fragment.py's clash deletion happened to
# remove.
group fragment molecule {{ params.frag_molid_lo }}:{{ params.frag_molid_hi }}
group hexadecane molecule 1:{{ params.max_org_molid }}
{% endif %}

neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes

compute mobtemp mobile temp
# No whole-box `compute pressure` here, and no barostat anywhere in this
# pipeline at all (see config.yaml's slab.settle_ps comment for the full
# history): it hard-requires group "all" (confirmed live 2026-11-08 --
# "Compute pressure must use group all"), and for this frozen-substrate
# system that whole-box pressure is dominated by the substrate's own
# internal virial, not the liquid's -- confirmed live 2026-11-11 to be
# exactly why an earlier NPT design settled at a stable but meaningless
# ~133,700 atm, and confirmed again 2026-11-13 that even a hand-rolled,
# liquid-only-pressure barostat replacement for that doesn't fix the
# underlying problem (its convergence rate turned out to be set by the
# liquid's own real compressibility regardless of tuning -- a structural
# dead end, not a signal-correctness bug). Box sizing is handled entirely
# by scripts/close_liquid_gap.py's deterministic, density-based resize
# instead; every stage here is box-fixed.

timestep {{ params.timestep_fs }}
