# Stage 4d: short restrained re-equilibration after scripts/insert_fragment.py
# has moved the fragment to the bulk-arc midpoint and removed whatever
# hexadecane it would otherwise overlap, and lmp_insert_minimize has
# resolved the remaining local clash. The fragment is held near that
# position with a per-atom spring back to wherever it already is at the
# start of THIS run (`spring/self`, the LAMMPS equivalent of a GROMACS
# position restraint -- its reference is each atom's position when the
# fix is defined, so no explicit target needs passing in here) while the
# solvent relaxes around it. The z-barostat is scoped to `hexadecane`
# only (not `mobile`) so it never fights the fragment's restraint --
# `dilate partial` on this fix only rescales hexadecane atoms (its own
# fix-group), leaving the restrained fragment's coordinates alone when
# the box adjusts. See lmp/npt_z.lmp.template's comment for why
# `press/berendsen`, not `fix npt`.
{% include "_common_setup.lmp.template" %}

compute hextemp hexadecane temp
compute hexpress all pressure hextemp
compute fragtemp fragment temp
thermo 500
thermo_style custom step c_hextemp c_hexpress c_fragtemp pe evdwl ecoul elong

fix frag_nvt fragment nvt temp {{ params.temperature_K }} {{ params.temperature_K }} 100.0
fix restrain_frag fragment spring/self {{ params.restraint_k }}
fix hex_nvt hexadecane nvt temp {{ params.temperature_K }} {{ params.temperature_K }} 100.0
fix npt_hex hexadecane press/berendsen z {{ params.pressure_atm }} {{ params.pressure_atm }} &
    {{ params.pressure_damp_fs }} modulus {{ params.modulus_atm }} dilate partial

run {{ params.restrained_npt_nsteps }}

unfix npt_hex
unfix hex_nvt
unfix restrain_frag
unfix frag_nvt

write_data restrained.data
write_restart restrained.restart
